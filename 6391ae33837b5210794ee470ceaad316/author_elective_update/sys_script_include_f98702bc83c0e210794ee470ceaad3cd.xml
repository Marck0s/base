        <name>GetUserBasesUtils</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var GetUserBasesUtils = Class.create();
GetUserBasesUtils.prototype = Object.extendsObject(AbstractAjaxProcessor, {
	getBases: function () {

		var userId = gs.getUserID();
		var baseGR = new GlideRecord('x_873666_bases_embedded_user_base_function');
		baseGR.addQuery('base_manager', userId);
		baseGR.query();

		var bases = [];
		while (baseGR.next()) {
			bases.push(baseGR.getValue('sys_id'));
		}

		return bases.join(',');
	}
});]]></script>
