        <name>x_873666_bases_base_registration</name>
        <operation display_value="read">read</operation>
        <script><![CDATA[// Obtém o sys_id do usuário logado
var userID = gs.getUserID();

// Obtém a Base associada ao registro atual
var baseGR = new GlideRecord('x_873666_bases_base_registration');
baseGR.addQuery('sys_id', current.base);
baseGR.addQuery('base_manager', userID); // Verifica se o usuário logado é o gerente da base
baseGR.query();

// Se encontrou a base onde o usuário é gerente, permite acesso
if (baseGR.hasNext()) {
    answer = true;
} else {
    answer = false;
}
]]></script>
