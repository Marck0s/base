        <script><![CDATA[var baseName = current.name;
var baseCity = current.city;
var baseState = current.state;

// Cheking dub name bases
var grName = new GlideRecord('x_873666_bases_base_registration');
grName.addQuery('name', baseName);
grName.query();

if (grName.next()) {
	gs.addErrorMessage("There is already a base with the same name. Please choose another one!");
	current.setAbortAction(true);
} 

// Cheking dub city and state bases
var grCityAndState = new GlideRecord('x_873666_bases_base_registration');
grCityAndState.addQuery('city', baseCity);
grCityAndState.addQuery('state', baseState);
grCityAndState.query();

if (grCityAndState.next()) {
	gs.addErrorMessage("There is already a base with the same city and state. Please choose another one!");
	current.setAbortAction(true);
} ]]></script>
